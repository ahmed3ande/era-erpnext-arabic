#. source: erpnext
msgid ""
"\n"
"\t\t\tThe Batch {0} of an item {1} has negative stock in the warehouse {2}. Please "
"add a stock quantity of {3} to proceed with this entry."
msgstr ""
"\n"
"\t\t\tالدفعة {0} للصنف {1} لديها رصيد سالب في المستودع {2}. يرجى إضافة كمية {3} "
"للمتابعة في هذا القيد."

#. source: erpnext
msgid ""
"\n"
"\t\t\tThe Batch {0} of an item {1} has negative stock in the warehouse {2}{3}.\n"
"\t\t\tPlease add a stock quantity of {4} to proceed with this entry.\n"
"\t\t\tIf it is not possible to make an adjustment entry, please enable 'Allow "
"Negative Stock for Batch' in the batch {0} or in the Stock Settings to proceed.\n"
"\t\t\tHowever, enabling this setting may lead to negative stock in the system.\n"
"\t\t\tSo please ensure the stock levels are adjusted as soon as possible to maintain "
"the correct valuation rate."
msgstr ""
"\n"
"\t\t\tالدفعة {0} للصنف {1} لديها رصيد سالب في المستودع {2}{3}.\n"
"\t\t\tيرجى إضافة كمية مخزون قدرها {4} للمتابعة في هذا القيد.\n"
"\t\t\tإذا تعذّر إجراء قيد تسوية، فيرجى تفعيل 'السماح بالمخزون السالب للدفعة' في "
"الدفعة {0} أو في إعدادات المخزون للمتابعة.\n"
"\t\t\tمع ذلك، قد يؤدي تفعيل هذا الإعداد إلى مخزون سالب في النظام.\n"
"\t\t\tلذا يرجى الحرص على تسوية مستويات المخزون في أقرب وقت للحفاظ على صحة سعر التقييم."

